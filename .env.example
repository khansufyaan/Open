# Rename to .env.local and fill with real credentials

# --- Plaid (bank linking / ACH identity) ---
PLAID_CLIENT_ID=
PLAID_SECRET=

# --- Privy (authentication + external wallet connect) ---
# Privy is the auth provider: email-OTP / wallet login for the receiver flow and
# external-wallet connect for senders. The server verifies Privy access tokens.
NEXT_PUBLIC_PRIVY_APP_ID=cmfyv8ebj00atl40ccnmgm3qo
# Server-side secret used to verify access tokens (required for the API routes).
PRIVY_APP_SECRET=
# Optional: pin the JWT verification (public) key to skip a JWKS fetch.
PRIVY_VERIFICATION_KEY=

# --- Identity verification / KYC ---
# KYC is handled by Bridge's hosted flow (Persona-powered under the hood).
# Bridge issues a short-lived bridge.withpersona.com link and reports the
# verified status authoritatively, so no client-side Persona keys are needed.
# Optional: where Bridge returns the user after completing KYC.
BRIDGE_KYC_REDIRECT_URI=
# Optional local demo: auto-approve KYC when BRIDGE_API_KEY is absent.
# Never enable in production.
BRIDGE_DEMO_AUTOAPPROVE=false

# --- Bridge (custodial wallets + transfers) ---
# Server-side API key from the Bridge dashboard.
BRIDGE_API_KEY=
# Optional overrides (sensible defaults applied when omitted).
BRIDGE_API_BASE_URL=https://api.bridge.xyz
BRIDGE_API_VERSION=v0
BRIDGE_DEFAULT_CHAIN=base
BRIDGE_TRANSFER_CURRENCY=usdc

# Company vault: the Bridge customer + wallet that holds inbound USDC deposits.
# Provision once via the Bridge dashboard or API, then set these.
BRIDGE_COMPANY_CUSTOMER_ID=
BRIDGE_COMPANY_WALLET_ID=
COMPANY_WALLET_ADDRESS=
NEXT_PUBLIC_COMPANY_WALLET_ADDRESS=

# Optional: separate DynamoDB table for recipient wallet mappings.
RECIPIENT_WALLETS_TABLE=blue-wallet-recipient-wallets

# Base USDC contract (used by the sender deposit flow).
BASE_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_RPC_URL=https://mainnet.base.org

# Surcharge percentage applied to transfers (default 0 if unset).
SURCHARGE_PERCENTAGE=5
